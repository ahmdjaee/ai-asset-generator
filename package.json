{
  "name": "ai-asset-generate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pembuat aset 3D .glb lokal dengan Claude (sesi login Claude Code) dan Blender headless",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "server": "bun server/main.ts",
    "web": "bun --bun vite",
    "build": "bun --bun vite build",
    "build:test": "bun --bun vite build --mode test",
    "start": "bun run build && NODE_ENV=production bun server/main.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun run test:server && bun run test:web",
    "test:server": "bun test ./server ./shared ./scripts ./tests/smoke ./tests/architecture",
    "test:web": "bun test --preload ./tests/setup/happy-dom.ts ./web",
    "test:coverage": "bun test --coverage ./server/domain ./server/agent",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:api": "bun test ./tests/e2e-api",
    "check": "bun run lint && bun run typecheck && bun run test && bun run test:coverage",
    "check:auth": "bun scripts/check-auth.ts",
    "tokens:sync": "bun scripts/sync-tokens.ts",
    "db:generate": "drizzle-kit generate",
    "runtime:build": "bun scripts/runtime.ts build",
    "runtime:samples": "bun scripts/runtime.ts samples",
    "test:assetkit": "bun scripts/runtime.ts test-assetkit",
    "test:pipeline": "bun test ./tests/pipeline",
    "pipeline:demo": "bun scripts/pipeline-demo.ts",
    "eval:base": "bun scripts/eval-base.ts",
    "textures:sync": "bun scripts/textures-sync.ts",
    "eval:texture": "bun scripts/eval-texture.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.323",
    "@anthropic-ai/sdk": "1.8.0",
    "@fontsource-variable/inter": "5.3.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@hono/bun": "1.0.1",
    "@hono/zod-validator": "0.9.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "gltf-validator": "2.0.0-dev.3.10",
    "hono": "4.13.18",
    "lucide-react": "1.72.0",
    "meshoptimizer": "1.3.0",
    "pino": "10.4.0",
    "playwright": "1.65.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "20.2.0",
    "react-router": "8.5.1",
    "rehype-harden": "1.1.9",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "streamdown": "2.7.1",
    "tailwind-merge": "3.7.0",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.7",
    "@happy-dom/global-registrator": "21.0.4",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "lefthook": "2.2.2",
    "pixelmatch": "8.0.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
