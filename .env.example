# Salin ke .env hanya bila perlu mengubah nilai bawaan. Semua variabel opsional.
# Server selalu bind ke 127.0.0.1; tidak ada opsi untuk membukanya ke jaringan.

# Port API. Saat `bun run dev`, Vite berjalan di 4341 dan meneruskan /api ke port ini.
PORT=4340

# Folder data lokal: database, aset, backup.
DATA_DIR=./data

# Level log pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Driver Claude: sdk (Claude sungguhan, memakai kuota langganan) | fake (skenario deterministik untuk tes/E2E).
AGENT_DRIVER=sdk

# Driver runtime 3D: docker (Blender di sandbox) | fixture (GLB dan contact sheet siap pakai, tanpa Docker).
RUNTIME_DRIVER=docker
